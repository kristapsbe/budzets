<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ (API 31+).
   Cloud backup: nothing. Budget data leaves the phone only through the app's own backup files
   (PROJECT_PLAN.md §6.8), never silently through Google's cloud backup (Q6).
   Device-to-device transfer (setting up a new phone from the old one, by cable or Wi-Fi): the
   database and settings go along (Q23). WorkManager's database is left out: its jobs belong to
   the old phone's widgets. noBackupFilesDir, which holds the pre-restore safety copy, is never
   transferred.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
    </device-transfer>
</data-extraction-rules>
