<?xml version="1.0" encoding="utf-8"?><!--
   Android 9-11 (API 28-30) equivalent of data_extraction_rules.xml. With includes present only
   included files are backed up, and each include requires a device-to-device transfer, so cloud
   backups carry nothing (Q6) while a transfer to a new phone carries the database and settings
   (Q23).
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <include domain="database" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="sharedpref" path="." requireFlags="deviceToDeviceTransfer" />
    <exclude domain="database" path="androidx.work.workdb" />
    <exclude domain="database" path="androidx.work.workdb-shm" />
    <exclude domain="database" path="androidx.work.workdb-wal" />
</full-backup-content>
