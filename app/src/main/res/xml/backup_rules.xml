<?xml version="1.0" encoding="utf-8"?><!--
   Android 9-11 (API 28-30) equivalent of data_extraction_rules.xml: keep the database and
   DataStore settings out of Auto Backup. The app's explicit backup is the only backup path.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="datastore/" />
</full-backup-content>
